+import androidx.fragment.app.Fragment
+import java.util.UUID
+
+// [diarino patch] Lives for the duration of one PiP session. It is independent of any VideoView's lifecycle, so
+// the app UI is always restored when PiP ends, even if the view that started PiP was unmounted meanwhile.
+class PiPSessionFragment : Fragment() {
+  val id = "${PiPSessionFragment::class.java.simpleName}_${UUID.randomUUID()}"
+
+  override fun onPictureInPictureModeChanged(isInPictureInPictureMode: Boolean) {
+    super.onPictureInPictureModeChanged(isInPictureInPictureMode)
+    if (!isInPictureInPictureMode) {
+      VideoView.exitPiPSession()
+    }
+  }
+}
